---
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';

import ContactCTA from '../../components/ContactCTA.astro';
import PortfolioPreview from '../../components/PortfolioPreview.astro';
import Hero from '../../components/Hero.astro';
import Grid from '../../components/Grid.astro';

import { getLangFromUrl } from '../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);

const projects = (await getCollection('work')).filter(
  (project) => project.slug.startsWith(`${currentLang}/`)
).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout
	title="העבודות שלי | אביב רואס"
	description="Learn about Aviv Roas's most recent projects"
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="העבודות שלי"
				tagline="הציצו בפרויקטים האחרונים שלי למטה ותוכלו לקבל טעימה מהניסיון שלי."
				align="start"
			/>
			<Grid variant="offset">
				{
					projects.map((project) => (
						<li>
							<PortfolioPreview project={project} />
						</li>
					))
				}
			</Grid>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>

<style>
	*{direction: rtl;}
</style>
